# ─────────────────────────────────────────────────────────────
# MB IQ backend environment template — copy to .env and fill in.
# NEVER commit the real .env (it is git-ignored). Maintained by Kone & Claude.
# ─────────────────────────────────────────────────────────────

# API
PORT=4000
NODE_ENV=development

# JWT signing secret for local auth (replace with a long random string in prod)
JWT_SECRET=
ALLOW_DEMO_SEED=false
SEED_PASSWORD=
JWT_EXPIRES_IN=8h

# Database — SQLite for the demo (plug-and-go).
# NOTE: for SQLite, Prisma resolves this path relative to the schema file
# (backend/prisma/schema.prisma), so "file:./dev.db" => backend/prisma/dev.db.
# To adopt the organisation's DB later, switch the Prisma datasource provider
# (postgresql / mysql) and point this at the org database, e.g.:
#   DATABASE_URL="postgresql://user:pass@host:5432/mbiq"
DATABASE_URL="file:./dev.db"

# Anthropic — placeholder for now. Add the real key here later; do not commit it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Auth provider: "local" today; "sso" once the org identity provider is wired in.
AUTH_PROVIDER=local

# GitHub MCP server (optional — the MCP Host activates when URL is set). Never commit real values.
GITHUB_MCP_URL=
GITHUB_MCP_TOKEN=

# Dual-currency display — approximate USD→ZAR rate for cost analytics (adjust to contracted rate).
USD_ZAR_RATE=18.5
